<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dofus</groupId>
        <artifactId>dofus-packet-decoder-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>dofus-api</artifactId>
    <name>Dofus API</name>
    <description>REST API and main application</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-network-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-packet-decoder</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-game-state</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-navigation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-combat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dofus</groupId>
            <artifactId>dofus-persistence</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Micrometer for Metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- DevTools for Development -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.dofus.api.DofusPacketDecoderApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
